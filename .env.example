# CryptoTrace AI - Environment Variables
# Copy this file to .env and fill in your values

# ─── Application ──────────────────────────────────────────────
APP_NAME=CryptoTrace AI
DEBUG=true
DEMO_MODE=true

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://cryptotrace:cryptotrace@localhost:5432/cryptotrace
DATABASE_SYNC_URL=postgresql://cryptotrace:cryptotrace@localhost:5432/cryptotrace

# ─── Authentication ───────────────────────────────────────────
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Blockchain Providers ────────────────────────────────────
# ETHERSCAN_API_KEY=your-etherscan-api-key
# BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/your-key

# ─── AI / LLM ────────────────────────────────────────────────
# OPENAI_API_KEY=your-openai-api-key
# AI_MODEL=gpt-4

# ─── Tracing Defaults ────────────────────────────────────────
MAX_TRACE_HOPS=5
MAX_TRACE_TRANSACTIONS=200
TRACE_TIME_WINDOW_HOURS=720
MIN_TRACE_AMOUNT=0.001

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
