# CryptoTrace AI - Local/demo environment template
# Do not use this file unchanged for hosted staging or production.
# Copy it to .env only for local work and replace every value as appropriate.

# ─── Application ──────────────────────────────────────────────
APP_NAME=CryptoTrace AI
DEBUG=true
DEMO_MODE=true
# Comma-separated exact browser/native origins. Demo mode defaults to the
# local frontend above; set this explicitly in hosted production.
# Hosted web + Capacitor Android:
# CORS_ORIGINS=https://cryptotrace-frontend.onrender.com,https://localhost

# ─── Database ─────────────────────────────────────────────────
# Local PostgreSQL is optional; README instructions use USE_SQLITE=true instead.
# A hosted demo that supplies DATABASE_URL must explicitly set USE_SQLITE=false;
# DEMO_MODE=true otherwise selects the local SQLite fallback by default.
DATABASE_URL=postgresql+asyncpg://cryptotrace:cryptotrace@localhost:5432/cryptotrace
# Reserved for future synchronous migration tooling; not used by the current runtime.
DATABASE_SYNC_URL=postgresql://cryptotrace:cryptotrace@localhost:5432/cryptotrace

# ─── Authentication ───────────────────────────────────────────
# Demo mode generates an ephemeral key if this remains unset.
# SECRET_KEY=<generate-a-random-value-at-least-32-characters-long>
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Blockchain Providers ────────────────────────────────────
# These variables are reserved by the current configuration but are not yet
# consumed by a live provider adapter. Do not treat them as live support.
# ETHERSCAN_API_KEY=<provider-key>
# BLOCKCHAIN_RPC_URL=https://<provider-endpoint>/<project-key>

# ─── AI / LLM ────────────────────────────────────────────────
# Keep this backend-only; never prefix it with NEXT_PUBLIC_.
# OPENAI_API_KEY=<openai-api-key>
# AI_MODEL=gpt-4

# ─── Tracing Defaults ────────────────────────────────────────
MAX_TRACE_HOPS=5
MAX_TRACE_TRANSACTIONS=200
TRACE_TIME_WINDOW_HOURS=720
MIN_TRACE_AMOUNT=0.001

# ─── Frontend ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Local demo: true. Hosted staging with PostgreSQL: explicitly false.
# USE_SQLITE=true
